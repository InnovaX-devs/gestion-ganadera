# Base de datos (docker compose y backend)
POSTGRES_DB=ganadera
POSTGRES_USER=ganadera
POSTGRES_PASSWORD=ganadera
POSTGRES_PORT=5450

# pgAdmin (opcional: docker compose --profile tools up -d)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Panel de administración del equipo de Innovax (http://localhost:5173/admin): se entra con uno de
# estos emails (separados por coma) y ADMIN_PASSWORD. Sin contraseña el panel queda cerrado.
# En producción usá una contraseña larga y que no se use en otro lado.
ADMIN_EMAILS=
ADMIN_PASSWORD=

# Suscripciones con Mercado Pago (docs/planes.md). Sin MP_ACCESS_TOKEN el pago online está apagado.
MP_ACCESS_TOKEN=
# Clave secreta de los webhooks (Tus integraciones → Webhooks). En producción, obligatoria.
MP_WEBHOOK_SECRET=
# Ningún plan es gratis: sin prueba, suscripción ni pago manual la cuenta queda en solo lectura.
# false = no pausar a nadie (para lanzar sin cortar cuentas existentes)
COBRO_EXIGIR_PAGO=true
# Solo para probar: email del comprador de prueba de Mercado Pago (@testuser.com)
MP_EMAIL_PAGADOR_PRUEBA=
# Si Mercado Pago rechaza localhost como URL de retorno, descomentá y poné una pública
# MP_BACK_URL=https://www.innovax-team.com
